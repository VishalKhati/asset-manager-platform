{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--executable-path", "/usr/bin/google-chrome", "--headless", "--isolated"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "postgres": {
      "command": "${HOME}/.local/share/mcp-servers/postgres-mcp/.venv/bin/postgres-mcp",
      "args": ["--access-mode", "restricted"],
      "env": {
        "DATABASE_URI": "${DEV_DATABASE_URL}"
      }
    }
  }
}
