{
  "name": "SMC Gold Bot — Trade Monitor (Opened / Closed)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smc-trade",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trade",
      "name": "Webhook (Trade Event)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK"
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event }}",
              "value2": "trade_opened"
            }
          ]
        }
      },
      "id": "check-event",
      "name": "Trade Opened or Closed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 380]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramApi",
        "resource": "message",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📂 *Trade OPENED*\n\nSymbol: XAUUSD\nDirection: `{{ $json.payload.direction }}`\nEntry: `${{ $json.payload.entry }}`\nStop Loss: `${{ $json.payload.sl }}`\nTake Profit: `${{ $json.payload.tp }}`\nLots: `{{ $json.payload.lots }}`\nConfidence: `{{ Math.round($json.payload.confidence * 100) }}%`\n\n🕐 {{ new Date($json.payload.openedAt).toLocaleTimeString() }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-opened",
      "name": "Telegram — Trade Opened",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [720, 260]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramApi",
        "resource": "message",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📁 *Trade CLOSED*\n\nSymbol: XAUUSD\nDirection: `{{ $json.payload.direction }}`\nEntry: `${{ $json.payload.entry }}`\nPnL: `{{ ($json.payload.pnl ?? 0) >= 0 ? '✅ +' : '❌ ' }}${{ $json.payload.pnl?.toFixed(2) }}`\n\n🕐 {{ new Date($json.payload.closedAt).toLocaleTimeString() }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-closed",
      "name": "Telegram — Trade Closed",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [720, 480]
    }
  ],
  "connections": {
    "Webhook (Trade Event)": {
      "main": [
        [
          { "node": "Respond 200 OK",          "type": "main", "index": 0 },
          { "node": "Trade Opened or Closed?",  "type": "main", "index": 0 }
        ]
      ]
    },
    "Trade Opened or Closed?": {
      "main": [
        [{ "node": "Telegram — Trade Opened", "type": "main", "index": 0 }],
        [{ "node": "Telegram — Trade Closed", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["smc-gold-bot", "trades"]
}
