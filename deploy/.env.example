# Copy to deploy/.env on the server and `chmod 600 .env`. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# --- Images ---
GHCR_OWNER=vishalkhati
IMAGE_TAG=main

# --- Web ---
# Your domain for automatic HTTPS (e.g. signals.example.com), or :80 behind another proxy.
SITE_ADDRESS=:80
PUBLIC_SITE_URL=https://signals.example.com
# Only these source ranges may reach /api/ingest (Tailscale by default).
INGEST_ALLOWED_CIDRS=100.64.0.0/10 127.0.0.1/8

# --- Database ---
POSTGRES_USER=amp
POSTGRES_PASSWORD=
POSTGRES_DB=amp

# --- Security (required in production) ---
JWT_SECRET=
COOKIE_SECURE=true
REGISTRATION_ENABLED=false
TRUST_PROXY=1
# Shared with the MT5 feeder (feeder/.env FEEDER_HMAC_SECRET).
FEEDER_HMAC_SECRET=
# Bearer token Prometheus uses for /api/metrics and the engine's :9464/metrics. Empty disables metrics.
METRICS_TOKEN=

# --- Signals ---
SYMBOL=XAUUSD
# shadow = record only · forward = private channel (demo forward test) · live = public channel
SIGNAL_MODE=forward
LATE_SIGNAL_S=120
FEED_SILENT_ALERT_MIN=10
PUBLIC_DELAY_MIN=0

# --- Telegram (optional; messages are recorded but not sent when unset) ---
TELEGRAM_BOT_TOKEN=
TG_CHANNEL_PRIVATE_ID=
TG_CHANNEL_PUBLIC_ID=
# Numeric Telegram user ids allowed to use /pause /resume /stats /health, comma-separated.
TG_ADMIN_IDS=

LOG_LEVEL=info
