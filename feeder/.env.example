# Copy to .env next to where the service runs. Never commit the real file.

# Signal service base URL. Reach it over Tailscale (or a Cloudflare Tunnel), not the open internet.
API_URL=https://signals.example.com
FEEDER_ID=mt5-vps-1
# Same value as FEEDER_HMAC_SECRET on the server. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FEEDER_HMAC_SECRET=

# Symbol as named in your MT5 terminal (brokers add suffixes such as XAUUSD.r or XAUUSDm).
BROKER_SYMBOL=XAUUSD
SERVICE_SYMBOL=XAUUSD

# Optional: log the terminal in automatically (otherwise it uses the saved login).
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Leave empty to detect the broker's UTC offset from the last tick (recommended).
MT5_UTC_OFFSET_MIN=

POLL_SECONDS=1
HEARTBEAT_SECONDS=30
BACKFILL_DAYS=20
STATE_PATH=feeder_state.sqlite3
