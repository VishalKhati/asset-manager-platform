# ════════════════════════════════════════════════════════════════════
#  SMC Bot — MT5 Bridge  ·  Configuration
#  Copy this file to .env and fill in your values.
#  Then run:  node bridge.js
# ════════════════════════════════════════════════════════════════════

# ── API Connection ───────────────────────────────────────────────────
# Your deployed Replit app URL (no trailing slash).
# Find it in your Replit project → Deploy → App URL.
# In dev (running locally), use: http://localhost:80/api
API_BASE_URL=https://your-app.replit.app/api

# API token — choose one of two options:
#
#  Option A (recommended — permanent):
#    Use your BOT_API_TOKEN Replit secret.
#    The bridge will authenticate as the "_system" machine user.
#    Copy the value from:  Replit → Secrets → BOT_API_TOKEN
#
#  Option B (personal — expires in 30 days):
#    Log into the dashboard, go to MT5 Setup, copy your Bridge Token.
#    The bridge will authenticate as your personal account.
#    Trades will appear under YOUR account in the dashboard.
#
API_TOKEN=changeme

# ── Symbol ──────────────────────────────────────────────────────────
# Which market to trade.
# Supported: XAUUSD (Gold) or BTCUSD (Bitcoin CFD)
# Run two bridge instances (different .env files) for both symbols.
SYMBOL=XAUUSD

# ── IPC Folder ──────────────────────────────────────────────────────
# Shared folder between this bridge (Node.js) and the MT5 EA.
# This MUST be the full path to the smc_bridge folder inside MT5's
# MQL5\Files\ directory.
#
# How to find your MT5 data folder:
#   MT5  →  File  →  Open Data Folder
#   Then navigate to:  MQL5\Files\
#
# Windows example:
#   C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\<HASH>\MQL5\Files\smc_bridge
#
# Linux / VPS with Wine:
#   /home/user/.wine/drive_c/users/user/AppData/Roaming/MetaQuotes/Terminal/<HASH>/MQL5/Files/smc_bridge
#
# Leave as ./ipc for dev/testing without MT5.
IPC_DIR=./ipc

# ── Timing ──────────────────────────────────────────────────────────
# How often (ms) the bridge polls /api/bot/signal for a new signal.
# 30000 = 30 seconds (recommended). Minimum: 10000.
POLL_INTERVAL_MS=30000

# How often (ms) the bridge checks for trade results written by MT5 EA.
RESULT_CHECK_MS=5000

# How often (ms) the bridge sends a heartbeat to the API dashboard.
HEARTBEAT_MS=30000

# ── Risk / Signal Filtering ──────────────────────────────────────────
# Minimum signal confidence required to forward to MT5 (0.0 – 1.0).
# Signals below this threshold are silently ignored.
# Increase to be more selective; decrease to trade more often.
MIN_CONFIDENCE=0.70

# ── Safety Mode ─────────────────────────────────────────────────────
# IMPORTANT: Both this setting AND the EA's DemoMode must be "live"
# before any real order is sent to your broker.
#
#   demo  →  IPC file written, EA logs the signal, NO real order
#   live  →  Real market orders sent (USE WITH EXTREME CAUTION)
#
TRADE_MODE=demo

# ── Logging ─────────────────────────────────────────────────────────
# Leave blank to log to stdout only.
# Set a path to also write to a log file.
LOG_FILE=./logs/bridge.log
